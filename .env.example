# App Configuration
APP_NAME=ResearchMatch
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-super-secret-key-for-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=research_user
POSTGRES_PASSWORD=research_password
POSTGRES_DB=researchmatch
DATABASE_URL=postgresql://research_user:research_password@localhost:5432/researchmatch

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Provider Configuration & Polite Mailto
OPENALEX_POLITE_EMAIL=user@example.com
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_POLITE_EMAIL=user@example.com

# Embedding Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
